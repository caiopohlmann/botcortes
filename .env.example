# Credenciais de app da Twitch (https://dev.twitch.tv/console/apps -> Register Your Application)
# OAuth Redirect URL pode ser http://localhost ; categoria "Application Integration".
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Opcional: grava sem anúncios usando uma conta Twitch com Turbo ou inscrita no canal.
# Valor do cookie "auth-token" da twitch.tv logada (DevTools -> Application -> Cookies).
# Use uma conta criada só para o bot.
TWITCH_OAUTH_TOKEN=

# Opcional. O Kick funciona sem conta; estas credenciais só são usadas se o Cloudflare do
# Kick bloquear a consulta "como navegador". Crie em kick.com -> Configurações ->
# Desenvolvedor (exige 2FA na conta). Use uma conta criada só para o bot.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# YouTube: não precisa de credencial.

# Senha do painel web. Obrigatória se panel.host for 0.0.0.0 (abrir pelo celular).
# No navegador: usuário qualquer + esta senha.
PANEL_PASSWORD=

# prod = PC Windows com RTX (NVENC + Whisper na GPU)
# dev  = Mac/CPU (libx264 + Whisper pequeno na CPU), sobrescreve com config/settings.dev.yaml
CORTES_PROFILE=prod

# Pasta de configuração (relativa à pasta de onde o comando é executado)
CORTES_CONFIG_DIR=config
